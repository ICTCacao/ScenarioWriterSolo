{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScenarioWriterWin",
  "version": "0.7.5",
  "identifier": "com.ictcacao.scenariowriterwin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ScenarioWriterSolo（Windows 版 β7.5）",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "../nsis/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "scwd"
        ],
        "name": "ScenarioWriter 作品",
        "description": "ScenarioWriterSolo の作品ファイル",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "resources": [
      "icons/scwd.ico"
    ]
  }
}